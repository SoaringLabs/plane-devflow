{
  "name": "plane-devflow",
  "version": "0.12.0",
  "description": "Install the complete Plane DevFlow plugin and verify its three skills.",
  "type": "module",
  "bin": { "plane-devflow": "bin/plane-devflow.mjs" },
  "engines": { "node": ">=20" },
  "files": [
    "bin/",
    "lib/",
    "plugins/plane-devflow/plugin.json",
    "plugins/plane-devflow/mcp.json",
    "plugins/plane-devflow/assets/icon.png",
    "plugins/plane-devflow/scripts/*.py",
    "plugins/plane-devflow/references/*.md",
    "plugins/plane-devflow/skills/*/SKILL.md",
    "plugins/plane-devflow/skills/*/agents/openai.yaml"
  ],
  "scripts": {
    "test": "node --test tests/installer.test.mjs tests/credential_isolation.test.mjs",
    "test:integration": "node tests/npx_integration.mjs",
    "test:skills": "node tests/skills_cli_integration.mjs",
    "test:agents": "node tests/multi_agent_integration.mjs"
  },
  "dependencies": { "cross-spawn": "7.0.6" },
  "license": "MIT",
  "author": "SoaringLabs",
  "repository": { "type": "git", "url": "https://github.com/SoaringLabs/plane-devflow.git" },
  "homepage": "https://github.com/SoaringLabs/plane-devflow#readme",
  "bugs": { "url": "https://github.com/SoaringLabs/plane-devflow/issues" },
  "keywords": ["codex", "plane", "plugin", "skills", "installer"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
